FROM archlinux:latest

ARG OQS_PREFIX=/opt/oqs
ARG LIBOQS_REF=main
ARG OQS_PROVIDER_REF=main
ARG MOSQUITTO_REF=v2.1.2
ARG MOSQUITTO_PRECONNECT_KEEPALIVE=240

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
        autoconf \
        automake \
        base-devel \
        bluez \
        bluez-utils \
        cmake \
        dbus \
        file \
        git \
        iproute2 \
        iputils \
        kmod \
        libtool \
        mosquitto \
        ninja \
        openssl \
        patch \
        perl \
        pkgconf \
        procps-ng \
        python \
        sudo \
        tcpdump \
        util-linux \
        wireshark-cli && \
    pacman -Scc --noconfirm

COPY benchmarking/patches/mosquitto-preconnect-keepalive.patch /tmp/mosquitto-preconnect-keepalive.patch

RUN git clone --depth 1 --branch "${MOSQUITTO_REF}" https://github.com/eclipse-mosquitto/mosquitto.git /tmp/mosquitto && \
    patch -d /tmp/mosquitto -p1 < /tmp/mosquitto-preconnect-keepalive.patch && \
    cmake -S /tmp/mosquitto -B /tmp/mosquitto/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_C_FLAGS="-DMOSQ_BENCH_PRECONNECT_KEEPALIVE=${MOSQUITTO_PRECONNECT_KEEPALIVE}" \
        -DWITH_APPS=OFF \
        -DWITH_CLIENTS=OFF \
        -DWITH_DOCS=OFF \
        -DWITH_PLUGINS=OFF \
        -DWITH_TESTS=OFF \
        -DWITH_TLS=ON \
        -DWITH_WEBSOCKETS=OFF && \
    cmake --build /tmp/mosquitto/build --target mosquitto && \
    install -m 0755 /tmp/mosquitto/build/src/mosquitto /usr/local/bin/mosquitto && \
    rm -rf /tmp/mosquitto /tmp/mosquitto-preconnect-keepalive.patch

RUN git clone --depth 1 --branch "${LIBOQS_REF}" https://github.com/open-quantum-safe/liboqs.git /tmp/liboqs && \
    cmake -S /tmp/liboqs -B /tmp/liboqs/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${OQS_PREFIX}" \
        -DBUILD_SHARED_LIBS=ON && \
    cmake --build /tmp/liboqs/build && \
    cmake --install /tmp/liboqs/build && \
    rm -rf /tmp/liboqs

RUN git clone --depth 1 --branch "${OQS_PROVIDER_REF}" https://github.com/open-quantum-safe/oqs-provider.git /tmp/oqs-provider && \
    cmake -S /tmp/oqs-provider -B /tmp/oqs-provider/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${OQS_PREFIX}" \
        -DCMAKE_PREFIX_PATH="${OQS_PREFIX}" \
        -DOPENSSL_ROOT_DIR=/usr \
        -DOPENSSL_MODULES_PATH="${OQS_PREFIX}/lib/ossl-modules" && \
    cmake --build /tmp/oqs-provider/build && \
    cmake --install /tmp/oqs-provider/build && \
    rm -rf /tmp/oqs-provider

COPY benchmarking/docker/server-entrypoint-benchmark.sh /usr/local/bin/ipsp-benchmark
RUN chmod +x /usr/local/bin/ipsp-benchmark

ENV ROOT_DIR=/workspace/ipsp_mqtt_tls_wolf
ENV OQS_PREFIX=${OQS_PREFIX}
ENV OPENSSL_MODULES=${OQS_PREFIX}/lib/ossl-modules
ENV LD_LIBRARY_PATH=${OQS_PREFIX}/lib
ENV OPENSSL_CONF=/workspace/ipsp_mqtt_tls_wolf/benchmarking/work/openssl-benchmark.cnf
ENV MQTT_PORT=8883

WORKDIR /workspace/ipsp_mqtt_tls_wolf
ENTRYPOINT ["/usr/local/bin/ipsp-benchmark"]
CMD ["help"]
