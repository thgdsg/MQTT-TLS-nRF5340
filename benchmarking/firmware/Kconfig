source "Kconfig.zephyr"

menu "Benchmark MQTT/TLS settings"

config APP_MQTT_BROKER_HOST
	string "MQTT broker IPv6 address"
	default "2001:db8::2"

config APP_MQTT_BROKER_PORT
	int "MQTT TLS broker port"
	default 8883

config APP_MQTT_CLIENT_ID
	string "MQTT client ID"
	default "nrf52840-benchmark"

config APP_MQTT_TELEMETRY_TOPIC
	string "MQTT telemetry topic"
	default "nrf52840/benchmark/telemetry"

config APP_MQTT_COMMAND_TOPIC
	string "MQTT command topic"
	default "nrf52840/benchmark/command"

config APP_MQTT_CMD_TIMEOUT_MS
	int "wolfMQTT command timeout in milliseconds"
	default 15000

config APP_TLS_HANDSHAKE_TIMEOUT_MS
	int "TLS handshake timeout in milliseconds"
	default 300000

config APP_TLS_IO_TIMEOUT_MS
	int "TLS socket I/O timeout in milliseconds"
	default 10000

config APP_MQTT_KEEPALIVE_SEC
	int "MQTT keepalive in seconds"
	default 60

config APP_BENCH_ITERATIONS
	int "Measured benchmark attempts"
	default 10

config APP_BENCH_WARMUP_ITERATIONS
	int "Warmup benchmark attempts"
	default 2

config APP_BENCH_PAUSE_MS
	int "Pause between benchmark attempts"
	default 1000

config APP_BENCH_INITIAL_DELAY_MS
	int "Delay before starting benchmark attempts"
	default 1000

config APP_BENCH_CONNECT_RETRIES
	int "Connection tries per benchmark attempt"
	default 5

config APP_BENCH_CONNECT_RETRY_DELAY_MS
	int "Delay after a failed connection try"
	default 500

config APP_BENCH_REBOOT_AFTER_ATTEMPT
	bool "Reboot after each benchmark attempt"
	default n
	help
	  Use this when the benchmark runner executes one attempt per IPSP
	  session. It gives each measured connection a fresh firmware/network
	  state without reflashing the board.

config APP_BENCH_VERBOSE_LOGS
	bool "Print verbose benchmark debug logs"
	default n
	help
	  Enable diagnostic printk output around TCP/TLS/MQTT setup and memory
	  accounting. Keep this disabled for benchmark runs to avoid serial output
	  affecting timing. Essential BENCH_* CSV lines are still printed.

config APP_BENCH_WOLFSSL_DEBUG
	bool "Print wolfSSL diagnostic logs"
	default n
	depends on APP_BENCH_VERBOSE_LOGS
	help
	  Compile wolfSSL error/debug logging for one-off diagnosis. Keep this
	  disabled during timing benchmarks because serial output changes results.

choice APP_BENCH_TLS_GROUP
	prompt "TLS 1.3 key exchange group"
	default APP_BENCH_TLS_GROUP_MLKEM512

config APP_BENCH_TLS_GROUP_MLKEM512
	bool "MLKEM512"

config APP_BENCH_TLS_GROUP_MLKEM768
	bool "MLKEM768"

config APP_BENCH_TLS_GROUP_MLKEM1024
	bool "MLKEM1024"

config APP_BENCH_TLS_GROUP_SECP256R1_MLKEM768
	bool "SecP256r1MLKEM768"

config APP_BENCH_TLS_GROUP_X25519_MLKEM768
	bool "X25519MLKEM768"

config APP_BENCH_TLS_GROUP_SECP384R1_MLKEM1024
	bool "SecP384r1MLKEM1024"

config APP_BENCH_TLS_GROUP_ECDHE_P256
	bool "ECDHE P-256"

config APP_BENCH_TLS_GROUP_ECDHE_P384
	bool "ECDHE P-384"

config APP_BENCH_TLS_GROUP_ECDHE_P521
	bool "ECDHE P-521"

endchoice

choice APP_BENCH_MLKEM_BACKEND
	prompt "ML-KEM implementation backend"
	default APP_BENCH_MLKEM_BACKEND_WOLFSSL
	help
	  Select which implementation performs ML-KEM key generation,
	  encapsulation and decapsulation for wolfSSL TLS 1.3 ML-KEM groups.
	  This affects MLKEM512/768/1024 and hybrid groups that include ML-KEM.

config APP_BENCH_MLKEM_BACKEND_WOLFSSL
	bool "wolfSSL built-in ML-KEM"

config APP_BENCH_MLKEM_BACKEND_PQM4_CLEAN
	bool "pqm4/PQClean clean ML-KEM via wolfSSL CryptoCb"
	depends on APP_BENCH_TLS_GROUP_MLKEM512 || APP_BENCH_TLS_GROUP_MLKEM768 || APP_BENCH_TLS_GROUP_MLKEM1024 || APP_BENCH_TLS_GROUP_SECP256R1_MLKEM768 || APP_BENCH_TLS_GROUP_X25519_MLKEM768 || APP_BENCH_TLS_GROUP_SECP384R1_MLKEM1024
	help
	  Route wolfSSL ML-KEM operations through pqm4's vendored PQClean
	  clean implementations. TLS, X.509 verification and MQTT remain
	  handled by wolfSSL/wolfMQTT.

endchoice

endmenu
