diff --git a/src/mqtt_broker.c b/src/mqtt_broker.c
--- a/src/mqtt_broker.c
+++ b/src/mqtt_broker.c
@@ -33,6 +33,7 @@
 
 #include <stdlib.h>
 #include <string.h>
+#include <stdio.h>
 
 #ifdef ENABLE_MQTT_TLS
     #include <wolfssl/wolfcrypt/random.h>
@@ -84,6 +84,10 @@
     #endif
 #endif
 
+#ifndef WOLFMQTT_BROKER_TLS_HANDSHAKE_TIMEOUT_S
+    #define WOLFMQTT_BROKER_TLS_HANDSHAKE_TIMEOUT_S 60
+#endif
+
+#if defined(WOLFMQTT_BROKER_KEYLOG_EXPORT) && \
+    defined(OPENSSL_EXTRA) && defined(HAVE_SECRET_CALLBACK)
+static void BrokerTls_KeyLogCallback(const WOLFSSL* ssl, const char* line)
+{
+    const char* path;
+    FILE* fp;
+
+    (void)ssl;
+
+    if (line == NULL) {
+        return;
+    }
+
+    path = getenv("WOLFMQTT_BROKER_KEYLOG_FILE");
+    if (path == NULL || path[0] == '\0') {
+        path = "host/broker.sslkeylog";
+    }
+
+    fp = fopen(path, "a");
+    if (fp == NULL) {
+        return;
+    }
+
+    fputs(line, fp);
+    fputc('\n', fp);
+    fclose(fp);
+}
+#endif
+
 /* -------------------------------------------------------------------------- */
 /* Logging helpers                                                             */
 /* -------------------------------------------------------------------------- */
@@ -326,6 +326,25 @@ static int BrokerTls_Init(MqttBroker* broker)
         mqtt_rc = MQTT_CODE_ERROR_MEMORY;
     }
 
+#ifdef WOLFMQTT_BROKER_FORCE_MLKEM_GROUP
+    if (mqtt_rc == MQTT_CODE_SUCCESS) {
+        int groups[] = { WOLFMQTT_BROKER_TLS_GROUPS };
+
+        wolf_rc = wolfSSL_CTX_set_groups(ctx, groups,
+            (int)(sizeof(groups) / sizeof(groups[0])));
+        if (wolf_rc != WOLFSSL_SUCCESS) {
+            WBLOG_ERR(broker, "broker: set TLS groups failed %d",
+                wolf_rc);
+            mqtt_rc = MQTT_CODE_ERROR_BAD_ARG;
+        }
+        else {
+            WBLOG_INFO(broker,
+                "broker: TLS 1.3 group MLKEM768");
+        }
+    }
+#endif
+
     /* Load server certificate */
     if (mqtt_rc == MQTT_CODE_SUCCESS) {
         if (broker->tls_cert == NULL) {
@@ -391,6 +410,14 @@ static int BrokerTls_Init(MqttBroker* broker)
         wolfSSL_CTX_SetIOSend(ctx, MqttSocket_TlsSocketSend);
     }
 
+#if defined(WOLFMQTT_BROKER_KEYLOG_EXPORT) && \
+    defined(OPENSSL_EXTRA) && defined(HAVE_SECRET_CALLBACK)
+    if (mqtt_rc == MQTT_CODE_SUCCESS) {
+        wolfSSL_CTX_set_keylog_callback(ctx, BrokerTls_KeyLogCallback);
+        WBLOG_INFO(broker, "broker: TLS keylog export enabled");
+    }
+#endif
+
     /* Mutual TLS: load CA and require client certificate */
     if (mqtt_rc == MQTT_CODE_SUCCESS && broker->tls_ca != NULL) {
 #ifndef NO_FILESYSTEM
@@ -4116,6 +4135,19 @@ static int BrokerClient_Process(MqttBroker* broker, BrokerClient* bc)
     /* Complete TLS handshake before processing MQTT packets */
     if (!bc->tls_handshake_done) {
         int ret;
+        WOLFMQTT_BROKER_TIME_T now = WOLFMQTT_BROKER_GET_TIME_S();
+        if ((now - bc->last_rx) >
+            (WOLFMQTT_BROKER_TIME_T)WOLFMQTT_BROKER_TLS_HANDSHAKE_TIMEOUT_S) {
+            WBLOG_ERR(broker,
+                "broker: TLS handshake timeout sock=%d after %u sec",
+                (int)bc->sock,
+                (unsigned int)WOLFMQTT_BROKER_TLS_HANDSHAKE_TIMEOUT_S);
+            BrokerSubs_RemoveClient(broker, bc);
+            BrokerClient_Remove(broker, bc);
+            return 0;
+        }
+
         bc->client.tls.timeout_ms_read = BROKER_TIMEOUT_MS;
         bc->client.tls.timeout_ms_write = BROKER_TIMEOUT_MS;
         ret = wolfSSL_accept(bc->client.tls.ssl);
@@ -806,6 +806,20 @@ static int BrokerPosix_Close(void* ctx, BROKER_SOCKET_T sock)
 {
     (void)ctx;
     if (sock != BROKER_SOCKET_INVALID) {
+    #ifdef SO_LINGER
+        struct linger linger_rst;
+
+        /* IPSP links can disappear while a TLS handshake is still in flight.
+         * Use an abortive close for broker-owned sockets so Linux does not
+         * leave 8883 stuck in FIN-WAIT after the BLE bt0 link has gone away. */
+        XMEMSET(&linger_rst, 0, sizeof(linger_rst));
+        linger_rst.l_onoff = 1;
+        linger_rst.l_linger = 0;
+        (void)setsockopt(sock, SOL_SOCKET, SO_LINGER,
+            &linger_rst, sizeof(linger_rst));
+    #endif
         close(sock);
     }
     return MQTT_CODE_SUCCESS;
